            "window": 30
          },
          "strategy_id": "CARRY_FUNDING_SURGE"
        },
        "instrument": "BTC-USD",
        "metric": {
          "formula": "mean(return_t+1 | funding_rate_t-1 > CARRYSURGE30_t (the premium is richer than usual)) - mean(return_t+1 | funding_rate_t-1 <= CARRYSURGE30_t (the premium is thinner than usual))",
          "name": "mean_forward_carry_return_1d(funding_t-1 > CARRYSURGE30) - mean_forward_carry_return_1d(funding_t-1 <= CARRYSURGE30)"
        },
        "outcome": {
          "formula": "24 * funding_rate_t+1 - (basis_t+1 - basis_t), basis = (perp_close - close) / close",
          "name": "carry_return_t+1"
        },
