    {
      "conditions": {
        "acceptance_criterion": {
          "comparison": "GT",
          "expected_direction": "INCREASE",
          "metric": "mean_forward_carry_return_1d(funding_t-1 > CARRYSURGE30) - mean_forward_carry_return_1d(funding_t-1 <= CARRYSURGE30)",
          "threshold": "0"
        },
        "analytical_rule": {
          "lower_or_equal_group": "funding_rate_t-1 <= CARRYSURGE30_t (the premium is thinner than usual)",
          "upper_group": "funding_rate_t-1 > CARRYSURGE30_t (the premium is richer than usual)"
        },
        "costs": {
          "declaration": "NOT_APPLICABLE: associative comparison has no orders, positions, fills, P&L, or execution"
        },
        "execution_scope": {
          "backtest_executed": false,
